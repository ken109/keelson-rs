 func RunTests(t *testing.T, cases Testcases, format FormatFunc) {
 	t.Helper()
+	goldenSrc, goldenDialect := goldenSource(1)
 	for name, tc := range cases {
 		t.Run(name, func(t *testing.T) {
 			sql, args, err := bob.Build(context.Background(), tc.Query)
+
+			g := GoldenCase{
+				Kind:         "query",
+				Dialect:      goldenDialect,
+				Source:       goldenSrc,
+				Name:         name,
+				Doc:          tc.Doc,
+				ExpectedSQL:  tc.ExpectedSQL,
+				GeneratedSQL: sql,
+				CleanSQL:     Clean(sql),
+				Args:         goldenArgs(args),
+			}
 			if err != nil {
+				g.BuildErr = err.Error()
+			}
+			if format != nil && err == nil {
+				if n, ferr := format(sql); ferr == nil {
+					g.NormalizedSQL = n
+				} else {
+					g.NormalizeError = ferr.Error()
+				}
+			}
+			goldenEmit(g)
+
+			if err != nil {
 				t.Fatalf("error: %v", err)
 			}
 			diff, err := QueryDiff(tc.ExpectedSQL, sql, format)
