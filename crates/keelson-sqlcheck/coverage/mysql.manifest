# Tier D manifest — every construct keelson-mysql claims to render.
#
# THIS DIALECT'S TIER IS TOKEN-LEVEL. There is no pg_query equivalent for
# MySQL (the sqlparser judge is generic and advisory — see keelson-sqlcheck's
# crate docs), so every entry here is detected by token signature against the
# recorded SQL: a signature is a literal substring of the canonical rendering
# (keywords uppercase, identifiers backticked), `{*}` matching one
# operand-shaped token (whitespace-free, not a bare uppercase keyword); a
# plain `*` is the literal character. Token matching cannot see structure — a
# LIMIT inside
# a derived table counts the same as one outside, and constructs whose
# rendering is indistinguishable at token level share one entry, with the
# collapse named in `api`.
#
# When the gate fails naming an id here: add a test that renders the construct
# through a judged assertion, or move the entry to mysql.exclusions with a
# reason.

# --- statements ------------------------------------------------------------

[stmt.select]
api = mysql::select
sig = SELECT

[stmt.insert]
api = mysql::insert
sig = INSERT

[stmt.replace]
api = mysql::replace
sig = REPLACE

[stmt.update]
api = mysql::update
sig = UPDATE

[stmt.delete]
api = mysql::delete
sig = DELETE

# --- statement modifiers ---------------------------------------------------

[modifier.distinct]
api = shared::distinct
sig = SELECT DISTINCT
sig = */ DISTINCT

[modifier.distinct_row]
api = shared::distinct_row
sig = DISTINCTROW

[modifier.low_priority]
api = shared::low_priority
sig = LOW_PRIORITY

[modifier.high_priority]
api = shared::high_priority
sig = HIGH_PRIORITY

[modifier.delayed]
api = shared::delayed
sig = DELAYED

[modifier.quick]
api = shared::quick
sig = QUICK

[modifier.ignore]
api = shared::ignore
sig =  IGNORE

[modifier.straight_join]
api = shared::straight (the statement modifier)
sig = SELECT STRAIGHT_JOIN
sig = */ STRAIGHT_JOIN

[modifier.sql_small_result]
api = shared::sql_small_result
sig = SQL_SMALL_RESULT

[modifier.sql_big_result]
api = shared::sql_big_result
sig = SQL_BIG_RESULT

[modifier.sql_buffer_result]
api = shared::sql_buffer_result
sig = SQL_BUFFER_RESULT

[modifier.sql_no_cache]
api = shared::sql_no_cache
sig = SQL_NO_CACHE

[modifier.sql_calc_found_rows]
api = shared::sql_calc_found_rows
sig = SQL_CALC_FOUND_ROWS

# --- optimizer hints -------------------------------------------------------

[hint.comment]
api = shared::optimizer_hint
sig = /*+

[hint.max_execution_time]
api = shared::max_execution_time
sig = MAX_EXECUTION_TIME(

[hint.set_var]
api = shared::set_var
sig = SET_VAR(

[hint.qb_name]
api = shared::qb_name
sig = QB_NAME(

[hint.resource_group]
api = shared::resource_group
sig = RESOURCE_GROUP(

# --- FROM items and index hints --------------------------------------------

[clause.from]
api = select::from / delete::using (FROM/USING table_references)
sig = FROM
sig = USING

[from.alias]
api = TableChain::as_ / JoinChain::as_ (token tier cannot tell it from other AS `…` aliases)
sig =  AS `

[from.comma_list]
api = select::from_also / delete::using_also (a comma in table_references)
sig = FROM {*},
sig = USING {*},

[update.table_also]
api = update::table_also (multi-table UPDATE, with or without aliases)
sig = UPDATE {*},
sig = UPDATE {*} AS {*},

[from.lateral]
api = TableChain::lateral / JoinChain::lateral
sig = LATERAL

[table.partition]
api = TableChain::partition / JoinChain::partition
sig =  PARTITION (

[index_hint.use]
api = TableChain::use_index / JoinChain::use_index
sig = USE INDEX

[index_hint.ignore]
api = TableChain::ignore_index / JoinChain::ignore_index
sig = IGNORE INDEX

[index_hint.force]
api = TableChain::force_index / JoinChain::force_index
sig = FORCE INDEX

[index_hint.for_join]
api = TableChain::for_join
sig = FOR JOIN

[index_hint.for_order_by]
api = TableChain::for_order_by
sig = FOR ORDER BY

[index_hint.for_group_by]
api = TableChain::for_group_by
sig = FOR GROUP BY

# --- joins -----------------------------------------------------------------

[join.inner]
api = shared::inner_join
sig = INNER JOIN

[join.left]
api = shared::left_join
sig = LEFT JOIN

[join.right]
api = shared::right_join
sig = RIGHT JOIN

[join.cross]
api = shared::cross_join
sig = CROSS JOIN

[join.straight]
api = shared::straight_join (the join operator, not the modifier)
sig = ` STRAIGHT_JOIN
sig = ) STRAIGHT_JOIN

[join.natural]
api = JoinChain::natural
sig = NATURAL

[join.on]
api = JoinChain::on / on_eq
sig =  ON

[join.using]
api = JoinChain::using
sig =  USING (

# --- WHERE / GROUP BY / HAVING / WINDOW ------------------------------------

[clause.where]
api = shared::where_
sig =  WHERE

[clause.group_by]
api = shared::group_by
sig = GROUP BY

[group.with_rollup]
api = shared::with_rollup
sig = WITH ROLLUP

[clause.having]
api = shared::having
sig =  HAVING

[clause.window]
api = shared::window
sig =  WINDOW `

# --- ORDER BY / LIMIT ------------------------------------------------------

[clause.order_by]
api = shared::order_by / order_by_combined / window::order_by / Function::order_by (token tier cannot tell them apart)
sig = ORDER BY

[order.asc]
api = OrderChain::asc
sig =  ASC

[order.desc]
api = OrderChain::desc
sig =  DESC

[expr.collate]
api = OrderChain::collate / MysqlOps::collate
sig =  COLLATE

[clause.limit]
api = shared::limit / limit_combined (token tier cannot tell them apart)
sig = LIMIT

[clause.offset]
api = shared::offset / offset_combined
sig = OFFSET

# --- locking ---------------------------------------------------------------

[lock.for_update]
api = shared::for_update
sig = FOR UPDATE

[lock.for_share]
api = shared::for_share
sig = FOR SHARE

[lock.of]
api = LockChain::of
sig = UPDATE OF `
sig = SHARE OF `

[lock.nowait]
api = LockChain::no_wait
sig = NOWAIT

[lock.skip_locked]
api = LockChain::skip_locked
sig = SKIP LOCKED

[lock.in_share_mode]
api = select::lock_in_share_mode
sig = LOCK IN SHARE MODE

# --- set operations --------------------------------------------------------

[combine.union]
api = shared::union
sig = UNION (

[combine.union_all]
api = shared::union_all
sig = UNION ALL (

[combine.intersect]
api = shared::intersect
sig = INTERSECT (

[combine.intersect_all]
api = shared::intersect_all
sig = INTERSECT ALL (

[combine.except]
api = shared::except
sig = EXCEPT (

[combine.except_all]
api = shared::except_all
