# --- WITH ------------------------------------------------------------------

[cte.with]
api = shared::with
sig = WITH

[cte.recursive]
api = shared::recursive
sig = WITH RECURSIVE

[cte.columns]
api = CteChain::columns
sig = `) AS (

# --- INSERT / REPLACE ------------------------------------------------------

[insert.columns]
api = TableChain::columns on insert::into / replace::into
sig = ` (`

[insert.values]
api = shared::values
sig =  VALUES (

[insert.multi_row]
api = shared::rows / repeated shared::values
sig = ), (

[insert.query]
api = insert::query / replace::query (INSERT … SELECT)
sig = ` SELECT
sig = ) SELECT

[clause.set]
api = update::set / set_col / insert::set (INSERT … SET row source; token tier cannot tell the two SET lists apart)
sig =  SET `
sig =  SET (

[insert.row_alias]
api = insert::as_ (VALUES … AS `alias`; token tier cannot tell it from a derived-table alias)
sig = ) AS `

[upsert.on_duplicate_key]
api = insert::on_duplicate_key_update
sig = ON DUPLICATE KEY UPDATE

[upsert.values_of]
api = mysql::values_of (VALUES(col) inside the upsert body)
sig = VALUES(`

# --- full-text search ------------------------------------------------------

[expr.match_against]
api = mysql::match_against / match_against_mode
sig = MATCH (
sig = AGAINST (

# --- windows and frames ----------------------------------------------------

[window.over_def]
api = Function::over
sig = OVER (

[window.over_name]
api = Function::over_name
sig = OVER `

[window.based_on]
api = window::based_on
sig = OVER (`
sig =  AS (`

[window.partition_by]
api = window::partition_by
sig = PARTITION BY

[frame.rows]
api = frame::rows
sig =  ROWS

[frame.range]
api = frame::range
sig =  RANGE

[frame.between]
api = any frame::to_* (an end bound makes the frame a BETWEEN)
sig = ROWS BETWEEN
sig = RANGE BETWEEN

[frame.unbounded_preceding]
api = frame::from_unbounded_preceding
sig = UNBOUNDED PRECEDING

[frame.preceding]
api = frame::from_preceding / to_preceding
sig =  {*} PRECEDING

[frame.current_row]
api = frame::from_current_row / to_current_row
sig = CURRENT ROW

[frame.following]
api = frame::from_following / to_following
sig =  {*} FOLLOWING

[frame.unbounded_following]
api = frame::from_unbounded_following / to_unbounded_following
sig = UNBOUNDED FOLLOWING

# --- function decorations --------------------------------------------------

[func.distinct]
